DATABASE_URL=postgres://pos_app:pos-app-local-only@localhost:5433/pos?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-bytes-before-use-0000000000
POS_ADDR=:8080
# Generate with: openssl rand -base64 32. Keep stable; it encrypts tenant provider credentials.
POS_CREDENTIALS_KEY=replace-with-32-byte-base64-encoded-key
# Public HTTPS URL of the API. Safaricom must be able to reach generated callback URLs here.
POS_PUBLIC_URL=https://pos.example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
TENANT_NAME=Example Organization
BUSINESS_NAME=Example Business
BRANCH_NAME=Main Branch
ADMIN_EMAIL=owner@example.com

# Tenant ID for login is printed by: task bootstrap-owner
# Example: 01a1b582-7418-78e9-9169-7354095a0045

POSTGRES_PORT=5433
